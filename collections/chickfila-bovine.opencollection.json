    {
      "info": {
        "name": "Summary",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Chick-fil-A Get Account Count",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.example.com/api/summary/accountcount"
          },
