          "info": {
            "name": "Chick-fil-A Get User Count",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.example.com/api/summary/usercount",
            "params": [
              {
                "name": "account",
                "value": "123456789012",
                "type": "query",
                "description": "The AWS account number (12-digit) or account alias to scope the request to."
              }
            ]
          },
          "docs": "Returns aggregate IAM user counts across accounts, optionally scoped to a single account."
        },
        {
          "info": {
            "name": "Chick-fil-A Get Instance Count",
            "type": "http"
          },
          "http": {
            "method": "GET",
