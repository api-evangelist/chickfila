        {
          "info": {
            "name": "Chick-fil-A Run Compliance Audit Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.example.com/api/reports/run"
          },
          "docs": "Triggers an asynchronous compliance audit Lambda that generates a new compliance report."
        }
