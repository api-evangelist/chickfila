              {
                "name": "account",
                "value": "123456789012",
                "type": "query",
                "description": "The AWS account number (12-digit) or account alias to scope the request to."
              }
            ]
          },
          "docs": "Returns aggregate EC2 instance counts across accounts, optionally scoped to a single account."
        }
