{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/chickfila/refs/heads/main/json-structure/bovine-load-balancer-list-structure.json",
  "name": "LoadBalancerList",
  "description": "A list of load balancers for an account.",
  "type": "object",
  "properties": {
    "LoadBalancers": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "An elastic load balancer record.",
        "properties": {
          "Region": {
            "type": "string",
            "example": "us-east-1"
          },
          "LoadBalancerName": {
            "type": "string",
            "example": "prod-web-elb"
          }
        }
      }
    }
  }
}