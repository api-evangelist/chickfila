{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoadBalancer",
  "description": "An elastic load balancer record.",
  "$id": "https://raw.githubusercontent.com/api-evangelist/chickfila/refs/heads/main/json-schema/bovine-load-balancer-schema.json",
  "type": "object",
  "properties": {
    "Region": {
      "type": "string",
      "example": "us-east-1"
    },
    "LoadBalancerName": {
      "type": "string",
      "example": "prod-web-elb"
    }
  }
}